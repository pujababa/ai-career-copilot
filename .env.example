# ==============================================================================
# AI Career Copilot — Environment Configuration Template
# Copy this file to .env and configure your production or local development keys.
# ==============================================================================

# Google Gemini API Key (Required for AI Chat, Roadmap, Mock Interview, and Daily Plan)
# Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Flask Session Security Secret Key (Required for session cookie signing)
# Generate a secure key using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_flask_secret_key_here

# Google OAuth 2.0 / OpenID Connect Credentials (Required for "Continue with Google" login)
# Configure an OAuth 2.0 Client ID at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Google OAuth Authorized Redirect URI (Must match exactly what is registered in Google Cloud Console)
# Exact redirect URI: http://127.0.0.1:10000/google-callback (Do not use localhost or port 5000)
GOOGLE_REDIRECT_URI=http://127.0.0.1:10000/google-callback

# Environment & Cookie Security (Optional for local development, recommended for HTTPS production)
# FLASK_ENV=production
# SESSION_COOKIE_SECURE=true

